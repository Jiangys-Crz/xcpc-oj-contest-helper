try:
    # qoj.ac sits behind Cloudflare, which fingerprints the TLS handshake;
    # plain requests/urllib3 is rejected with "HTTP 403 / Just a moment...".
    from curl_cffi import requests

    try:
        from curl_cffi.requests.errors import RequestsError as _RequestException
    except Exception:
        _RequestException = Exception
    _IMPERSONATE = 'firefox147'
except ImportError:
    import requests

    _RequestException = requests.RequestException
    _IMPERSONATE = None

