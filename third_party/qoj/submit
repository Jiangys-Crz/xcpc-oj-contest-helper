    source = Path(sys.argv[1]) if __name__ == '__main__' else None
    config_path, contest = submission_configuration(source)
    if contest.get('platform') not in (None, 'qoj'):
        raise VPError('This directory is not configured for QOJ submissions.')
    missing = [key for key in ('name', 'base_url', 'problems', 'offset', 'user_agent', 'cookie')
               if key not in contest]
    if missing:
        raise VPError(f'{config_path} is missing QOJ fields: ' + ', '.join(missing)
                      + '. Run vp qoj ID to regenerate the submission configuration.')
    refresh_submission_login(config_path, contest, 'qoj')
except VPError as exc:
    raise SystemExit('submit: ' + str(exc)) from None

contest_name: str = contest['name']
contest_base_url: str = contest['base_url']
contest_problems: str = contest['problems']
contest_offset: int = contest['offset']
user_agent: str = contest['user_agent']
cookie: str = contest['cookie']

def post_form(session, url, fields):
    """POST a multipart form body.

    requests accepts the files= mapping below, but curl_cffi rejects it outright
    ("files is not supported, use `multipart`") and wants a CurlMime instead.
    The two spellings produce the same multipart body, so the form fields and
    their values are shared.
    """
    if _IMPERSONATE:
        from curl_cffi import CurlMime

        mime = CurlMime()
        for name, spec in fields.items():
            content = spec[1]
            if not isinstance(content, bytes):
                content = str(content).encode()
            if len(spec) == 3:
                # (filename, content, content_type) -- the empty "file" part.
                # filename is passed through as-is: requests emits filename=""
                # for an empty name and curl_cffi must do the same, so an empty
                # string must not be collapsed to None.
                mime.addpart(name=name, data=content,
                             filename=spec[0], content_type=spec[2])
            else:
                mime.addpart(name=name, data=content)
        try:
            return session.post(url, multipart=mime, allow_redirects=False, timeout=(10, 40))
        finally:
            mime.close()
    return session.post(url, files=fields, allow_redirects=False, timeout=(10, 40))


def submit(url: str, lang: str, code: str, problem: str) -> None:
    origin = 'https://' + urlsplit(contest_base_url).netloc
    if (urlsplit(origin).hostname not in ('qoj.ac', 'www.qoj.ac', 'contest.ucup.ac', 'www.contest.ucup.ac')
            or urlsplit(origin).username or urlsplit(origin).password or urlsplit(origin).port
            or urlsplit(url).scheme != 'https' or urlsplit(url).netloc != urlsplit(origin).netloc):
        raise VPError('QOJ returned an unexpected submission destination. No code was submitted.')
    # Login was refreshed before loading this script. Keep subsequent native
    # Set-Cookie values in a scoped jar, never a fixed Cookie request header.
    web = WebSession(origin, contest)
    try:
        return submit_with_session(web, url, lang, code, problem)
    finally:
        web.session.close()


def submit_with_session(web, url: str, lang: str, code: str, problem: str) -> None:
    session = web.session
    # Some QOJ versions redirect to the submissions list instead of to an
    # assigned ID. Capture the old IDs so an old submission cannot look new.
    handle = contest.get('handle') or contest.get('vp_context', {}).get('handle')
    previous = None
    if handle:
        baseline = web.get(contest_base_url + '/submissions', params={'submitter': handle, 'locale': 'en'})
        if baseline.status_code == 200 and urlsplit(baseline.url).path == urlsplit(contest_base_url).path + '/submissions':
            previous = qoj_submission_ids(baseline.text)

    # Read the form last: a baseline GET can itself rotate the session and
    # invalidate a token read before it. Every command gets fresh native data.
    response = web.get(url)
    if urlsplit(response.url).netloc != urlsplit(url).netloc or urlsplit(response.url).path != urlsplit(url).path:
        raise VPError('QOJ did not return the requested submission page. No code was submitted.')
    parser = LexborHTMLParser(response.text)
    token_node = parser.css_first('input[name="_token"]')
    dynamic_token = token_node.attributes.get('value', '') if token_node else ''
    if not dynamic_token:
        print_judging_link(contest_base_url)
        raise VPError('QOJ did not provide a submission token. Refresh the browser login; no code was submitted.')

    payload_files = {
        '_token': (None, dynamic_token),
        'answer_answer_language': (None, lang),
        'answer_answer_upload_type': (None, 'editor'),
        'answer_answer_editor': (None, code),
        'answer_answer_file': ('', b'', 'application/octet-stream'),
        'submit-answer': (None, 'answer')
    }

    submitted_at = platform_now(contest["base_url"])
    try:
        submit_response = post_form(session, url, payload_files)
    except _RequestException:
        print_judging_link(contest_base_url)
        raise SystemExit('Server confirmation unavailable. Check the submissions page before retrying.') from None
    honor_judge_response_cookies(session, submit_response)
    origin = 'https://' + urlsplit(contest_base_url).netloc
    sid = qoj_submission_id(submit_response, origin)
    target = urljoin(url, submit_response.headers.get('Location', ''))
    destination = urlsplit(target)
    if (sid is None and previous is not None and submit_response.status_code in (302, 303)
            and destination.netloc == urlsplit(origin).netloc and destination.scheme == 'https'
            and destination.path in ('/submissions', urlsplit(contest_base_url).path + '/submissions')):
        try:
            current = web.get(contest_base_url + '/submissions', params={'submitter': handle, 'locale': 'en'})
        except (_RequestException, VPError):
            print_judging_link(contest_base_url)
            raise SystemExit('Submission confirmation unavailable. Check the result link before retrying.') from None
        if current.status_code == 200:
            sid = qoj_id_from_list(current.text, previous, contest_base_url, urlsplit(url).path.rsplit('/', 1)[-1], handle)
    if sid is None:
        print_judging_link(contest_base_url)
        page = LexborHTMLParser(submit_response.text)
        errors = [node.text(strip=True) for node in page.css('.error, .error-message, .alert-danger')]
        detail = ' '.join(dict.fromkeys(errors))
        if not detail:
            detail = ('The platform requests browser verification.' if 'cf-chl-' in submit_response.text or 'Just a moment...' in submit_response.text
                      else 'Check the submissions page before retrying; the request was not repeated.')
        raise SystemExit('QOJ did not confirm this submission (HTTP ' + str(submit_response.status_code) + '): ' + redact(detail, [dynamic_token, cookie])[:500])
    print(f'Submission #{sid}: PENDING', flush=True)
    try:
        record_receipt(contest, sid, problem, submitted_at)
    except (VPError, OSError) as exc:
        print('Submitted, but the monitor notification failed: ' + str(exc))
    print_judging_link(contest_base_url, sid)


if __name__ == '__main__':
    if len(sys.argv) not in (2, 3):
        print('Usage: submit code.cpp [-y]')
        sys.exit(-1)

    file_name = sys.argv[1]

    code_path = Path(file_name)
    if not code_path.exists():
        print(f'Error: {file_name} does not exist')
        sys.exit(-1)

    if code_path.suffix not in LANG_MAPPING:
        print(f'Error: unknown suffix {code_path.suffix}')
        sys.exit(-1)

    lang = LANG_MAPPING[code_path.suffix]
    problem = code_path.stem[0].capitalize()
    index = contest_problems.find(problem)
    if index == -1:
        print(f'Error: cannot find problem {problem}')
        sys.exit(-1)

    problem_id = contest.get('problem_ids', {}).get(problem, contest_offset + index)
    url = contest_base_url + '/problem/' + str(problem_id)

    from vp_helper.submission_confirmation import confirm_submission
    if confirm_submission(code_path, contest, problem, lang, url, config_path,
                          **({'assume_yes': True} if len(sys.argv) == 3 else {})):
        code = code_path.read_text('utf8')
        try:
            submit(url, lang, code, problem)
        except (VPError, OSError, UnicodeError) as exc:
            raise SystemExit('submit: ' + redact(str(exc), [cookie])) from None
