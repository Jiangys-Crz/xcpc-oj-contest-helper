+def post_form(session, url, fields):
+    """POST a multipart form body.
+
+    requests accepts the files= mapping below, but curl_cffi rejects it outright
+    ("files is not supported, use `multipart`") and wants a CurlMime instead.
+    The two spellings produce the same multipart body, so the form fields and
+    their values are shared.
+    """
+    if _IMPERSONATE:
+        from curl_cffi import CurlMime
+
+        mime = CurlMime()
+        for name, spec in fields.items():
+            content = spec[1]
+            if not isinstance(content, bytes):
+                content = str(content).encode()
+            if len(spec) == 3:
+                # (filename, content, content_type) -- the empty "file" part.
+                # filename is passed through as-is: requests emits filename=""
+                # for an empty name and curl_cffi must do the same, so an empty
+                # string must not be collapsed to None.
+                mime.addpart(name=name, data=content,
+                             filename=spec[0], content_type=spec[2])
+            else:
+                mime.addpart(name=name, data=content)
+        try:
+            return session.post(url, multipart=mime, allow_redirects=False, timeout=(10, 40))
+        finally:
+            mime.close()
+    return session.post(url, files=fields, allow_redirects=False, timeout=(10, 40))
+
+
+def submit(url: str, lang: str, code: str, problem: str) -> None:
+    origin = 'https://' + urlsplit(contest_base_url).netloc
+    if (urlsplit(origin).hostname not in ('qoj.ac', 'www.qoj.ac', 'contest.ucup.ac', 'www.contest.ucup.ac')
+            or urlsplit(origin).username or urlsplit(origin).password or urlsplit(origin).port
+            or urlsplit(url).scheme != 'https' or urlsplit(url).netloc != urlsplit(origin).netloc):
+        raise VPError('QOJ returned an unexpected submission destination. No code was submitted.')
+    # Login was refreshed before loading this script. Keep subsequent native
+    # Set-Cookie values in a scoped jar, never a fixed Cookie request header.
+    web = WebSession(origin, contest)
+    try:
+        return submit_with_session(web, url, lang, code, problem)
+    finally:
+        web.session.close()
+
+
+def submit_with_session(web, url: str, lang: str, code: str, problem: str) -> None:
+    session = web.session
+    # Some QOJ versions redirect to the submissions list instead of to an
+    # assigned ID. Capture the old IDs so an old submission cannot look new.
+    handle = contest.get('handle') or contest.get('vp_context', {}).get('handle')
+    previous = None
+    if handle:
+        baseline = web.get(contest_base_url + '/submissions', params={'submitter': handle, 'locale': 'en'})
+        if baseline.status_code == 200 and urlsplit(baseline.url).path == urlsplit(contest_base_url).path + '/submissions':
+            previous = qoj_submission_ids(baseline.text)
+
+    # Read the form last: a baseline GET can itself rotate the session and
+    # invalidate a token read before it. Every command gets fresh native data.
+    response = web.get(url)
+    requested, returned = urlsplit(url), urlsplit(response.url)
+    statement_page = re.fullmatch(re.escape(requested.path) + r'/statement/[A-Za-z0-9_-]+/?', returned.path)
+    if (returned.netloc != requested.netloc or returned.scheme != requested.scheme
+            or returned.path != requested.path and not statement_page):
+        address = f'{returned.scheme}://{returned.hostname or ""}{returned.path}'
+        raise VPError(f'QOJ did not return the requested submission page (received {address!r}). No code was submitted.')
+    # Language pages use their own URL as the native answer form action.
+    # Keep the original problem URL for receipt matching below.
+    post_url = response.url if statement_page else url
