{
  "manifest_version": 3,
  "name": "XCPC 登录同步",
  "version": "0.8.0",
  "description": "将当前普通浏览器中比赛网站的登录状态同步给本机 XCPC。",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://qoj.ac/*",
    "https://oj.cwnupaa.com/*",
    "https://cwnupaa.com/*",
    "https://ac.nowcoder.com/*",
    "https://nowcoder.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
